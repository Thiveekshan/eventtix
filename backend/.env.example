# Settings for running the API directly with "npm start" (outside Docker).
# Export these in your shell, or use:  node --env-file=.env src/server.js

DATABASE_URL=postgres://eventtix:CHANGE-ME@localhost:5432/eventtix
JWT_SECRET=CHANGE-ME-long-random-string
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Optional
ADMIN_EMAIL=admin@eventtix.local
ADMIN_PASSWORD=CHANGE-ME-admin-password
SEED_DEMO_DATA=true
