# Template for the monitoring secret file. Copy it, fill it in, and upload it to Jenkins as a
# "Secret file" credential with the ID eventtix-monitoring-secrets. NEVER commit the filled-in copy.

# Password for the Grafana "admin" user.
GRAFANA_ADMIN_PASSWORD=CHANGE-ME

# OPTIONAL: a Discord webhook address, so alerts arrive in a Discord channel.
#   Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
# Leave it empty to skip Discord (alerts are then only shown in Prometheus, Alertmanager and Grafana).
DISCORD_WEBHOOK_URL=
