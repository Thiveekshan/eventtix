      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"EventTix.*\"}",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{alertname}} ({{severity}})"
        }
      ]
    }
  ]
}