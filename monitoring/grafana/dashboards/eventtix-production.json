          },
          "expr": "rate(process_cpu_seconds_total{job=\"eventtix-api\"}[1m])",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Alerts over time",
      "description": "Each line is an alert that was firing at that moment: this is the incident history.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
