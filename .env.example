# Copy this file to ".env" and change every CHANGE-ME value. Never commit ".env".

# Database password. Use letters and numbers only (it is placed inside a URL).
POSTGRES_PASSWORD=CHANGE-ME-letters-and-numbers-only

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE-ME-long-random-string

# The first admin account, created on startup if it does not exist yet.
ADMIN_EMAIL=admin@eventtix.local
ADMIN_PASSWORD=CHANGE-ME-admin-password

# true = add five sample events the first time the app starts.
SEED_DEMO_DATA=true

# Ports on your computer.
FRONTEND_PORT=8080
BACKEND_PORT=3000
