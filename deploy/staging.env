# Staging: where every build is deployed and tested automatically. Not secret.
APP_ENV=staging
FRONTEND_PORT=8081
BACKEND_PORT=3001
CORS_ORIGINS=http://localhost:8081
SEED_DEMO_DATA=true
# Staging runs the image that was just built locally.
IMAGE_PREFIX=
PULL_POLICY=never
# "full" smoke test makes a test booking and cancels it again.
SMOKE_MODE=full
