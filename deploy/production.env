# Production: only builds that passed every earlier stage are released here. Not secret.
APP_ENV=production
FRONTEND_PORT=8082
BACKEND_PORT=3002
CORS_ORIGINS=http://localhost:8082
# Sample events so the demo site is not empty. Set to false for a real launch.
SEED_DEMO_DATA=true
# Production runs the stored release artifact from the registry, pulled every time.
IMAGE_PREFIX=localhost:5000/
PULL_POLICY=always
# "read-only" smoke test: checks everything but never creates data in production.
SMOKE_MODE=read-only
