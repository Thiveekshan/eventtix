# Template for an environment's secret file. Copy it, fill it in, and upload it to Jenkins
# as a "Secret file" credential. NEVER commit the filled-in copy.
#
# POSTGRES_PASSWORD: letters and numbers only (it is placed inside a connection URL)
# JWT_SECRET:        long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ADMIN_*:           the first administrator account, created on first start

POSTGRES_PASSWORD=CHANGE-ME
JWT_SECRET=CHANGE-ME
ADMIN_EMAIL=admin@eventtix.local
ADMIN_PASSWORD=CHANGE-ME
